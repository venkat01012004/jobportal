# =============================================================
# Job Portal - Environment Variables Example
# Copy this file to ".env" in the project root and adjust values
#   cp .env.example .env
# =============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root_super_secret
MYSQL_DATABASE=job_portal
MYSQL_USER=job_portal_user
MYSQL_PASSWORD=job_portal_pass
MYSQL_PORT=3306

# ---------- Backend (Node.js/Express) ----------
NODE_ENV=production
BACKEND_PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
UPLOAD_DIR=/app/uploads

# Database connection details used by the backend service
DB_HOST=mysql
DB_PORT=3306
DB_NAME=job_portal
DB_USER=job_portal_user
DB_PASSWORD=job_portal_pass

# ---------- Frontend (React) ----------
# Base URL the browser uses to reach the API (goes through Nginx)
REACT_APP_API_URL=/api
FRONTEND_PORT=3000

# ---------- Nginx (reverse proxy, public entrypoint) ----------
NGINX_PORT=8080
